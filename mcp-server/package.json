{
  "name": "@promptroot/mcp-server",
  "version": "0.1.1",
  "description": "MCP server + CLI for the PromptRoot dev-history wiki. Lets coding agents (Claude Code, Cursor, Continue, Cline) and humans search, read, and write SDDs.",
  "type": "module",
  "bin": {
    "promptroot-mcp-server": "bin/promptroot-mcp-server.js",
    "promptroot-mcp-login": "bin/promptroot-mcp-login.js",
    "promptroot-tenant-init": "bin/promptroot-tenant-init.js",
    "promptroot-sdd-push": "bin/promptroot-sdd-push.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js"
  },
  "scripts": {
    "postinstall": "node ./bin/postinstall.js",
    "start": "node ./bin/promptroot-mcp-server.js",
    "login": "node ./bin/promptroot-mcp-login.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "promptroot",
    "agents",
    "wiki",
    "rag",
    "claude-code"
  ],
  "license": "AGPL-3.0-only"
}
