{
  "name": "promptroot-vscode",
  "displayName": "Promptroot",
  "description": "VS Code extension for Promptroot workflows and asset management",
  "version": "0.1.0",
  "publisher": "promptroot",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:promptroot.initialize",
    "workspaceContains:**/prompts/**"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptroot.initialize",
        "title": "Promptroot: Initialize Workspace"
      },
      {
        "command": "promptroot.openDocs",
        "title": "Promptroot: Open Documentation"
      },
      {
        "command": "promptroot.browseAssets",
        "title": "Promptroot: Browse Assets"
      },
      {
        "command": "promptroot.refreshAssets",
        "title": "Promptroot: Refresh Assets",
        "icon": "$(refresh)"
      },
      {
        "command": "promptroot.createAsset",
        "title": "Promptroot: Create New Prompt Asset",
        "icon": "$(add)"
      },
      {
        "command": "promptroot.configureJulesApi",
        "title": "Promptroot: Configure Jules API"
      },
      {
        "command": "promptroot.viewJulesSources",
        "title": "Promptroot: View Jules Sources"
      },
      {
        "command": "promptroot.viewJulesSessions",
        "title": "Promptroot: View Jules Sessions"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "promptroot.assetsView",
          "name": "Promptroot Assets"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "promptroot.refreshAssets",
          "when": "view == promptroot.assetsView",
          "group": "navigation"
        },
        {
          "command": "promptroot.createAsset",
          "when": "view == promptroot.assetsView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Promptroot",
      "properties": {
        "promptroot.assetsPath": {
          "type": "string",
          "default": "prompts",
          "description": "Path to Promptroot assets directory relative to workspace root"
        },
        "promptroot.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect Promptroot workspaces"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.32.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^8.x",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  }
}
