rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Jules API Keys - users can only read/write their own key
    match /julesKeys/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User preferences (favorites, settings, etc.) - users can only access their own
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User profiles (timezone preferences, etc.) - users can only access their own
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Jules Queues - users can only access their own queue items
    match /julesQueues/{userId}/items/{itemId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
    }
    
    // User Copens - users can only access their own custom copens
    match /userCopens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Jules Sessions - users can only access their own session tracking data
    match /juleSessions/{userId}/sessions/{sessionId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
    }
    
    // Jules Session Activities - users can only access their own activity data
    match /juleSessions/{userId}/sessions/{sessionId}/activities/{activityId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Jules Analytics - users can only access their own analytics
    match /juleSessions/{userId}/analytics/{period} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Optional: Prompt History - users can only access their own history
    match /promptHistory/{userId}/items/{historyId} {
      allow read, write, list: if request.auth != null && request.auth.uid == userId;
    }
    
    // Optional: Prompt Queue - users can only access their own queued prompts
    match /promptQueue/{userId}/items/{queueId} {
      allow read, write, list: if request.auth != null && request.auth.uid == userId;
    }
    
    // OpenClaw gateway keys - users can only access their own
    match /openclawKeys/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Relay connection status - written by relay (admin SDK), read-only for the user
    match /relayStatus/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Agent API Keys - admin SDK only, no client direct access
    match /agentKeys/{userId} {
      allow read, write: if false;
    }

    // Agent API Key reverse-lookup index - admin SDK only, no client direct access
    match /agentKeysByHash/{tokenHash} {
      allow read, write: if false;
    }

    // Wiki content is served exclusively through Cloud Functions, which enforce
    // per-caller access control. Direct client reads are denied so that no wiki
    // content is reachable from the Firestore client SDK regardless of visibility.

    // Legacy wiki collections - deprecated, superseded by tenants/. Deny all.
    match /wikiDocs/{slug}   { allow read, write: if false; }
    match /wikiChunks/{chunkId} { allow read, write: if false; }

    // Multi-tenant wiki: tenant docs, their SDDs, and version history.
    // All reads and writes go through Cloud Functions (Admin SDK), which check
    // ownership/sharing before returning content. No direct client access.
    match /tenants/{tenantId} {
      allow read, write: if false;

      match /sdds/{slug} {
        allow read, write: if false;

        match /versions/{versionId} {
          allow read, write: if false;
        }
      }
    }

    // Per-tenant chunk index docs - server-only.
    match /tenantChunks/{tenantId}/chunks/{chunkId} {
      allow read, write: if false;
    }

    // CLI/MCP device-flow session tokens. Owner can read and list their own; writes are server-only.
    match /userSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Pending device-auth requests (short-lived). Server-only.
    match /deviceAuthRequests/{deviceCode} {
      allow read, write: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
